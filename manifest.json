{
  "manifest_version": 3,
  "name": "Sponsored Check",
  "version": "0.7.0",
  "description": "Shows whether a UK job posting offers visa sponsorship.",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Sponsored Check", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["keywords.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
